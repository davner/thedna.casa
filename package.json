{
  "name": "thedna-casa",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "check": "pnpm run \"/^(lint|format:check|typecheck|test)$/\" && pnpm run \"/^(validate:html|test:e2e|lhci)$/\""
  },
  "dependencies": {
    "@fontsource/averia-serif-libre": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "d3-shape": "^3.2.0",
    "fontkit": "^2.0.4",
    "perfect-freehand": "^1.2.3",
    "sharp": "^0.35.5",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-shape": "^3.2.0",
    "@types/fontkit": "^2.0.9",
    "@types/three": "^0.186.0",
    "cheerio": "^1.2.0",
    "color-name": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svg-path-commander": "^2.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
