---
import { copy } from "../content";
---

<footer>
  <span lang="es">{copy.signoff}</span> · © {new Date().getFullYear()} {copy.title}
</footer>

<style>
  footer {
    text-align: center;
    padding: calc(var(--spacing) * 12) calc(var(--spacing) * 5) calc(var(--spacing) * 24);
    color: var(--cream);
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: var(--tracking-normal);
  }
</style>
