---
import { brushSquiggle } from "../lib/shapes";
import { heroTitleSize, type HeroLayout } from "../lib/hero-title";
interface Props {
  class?: string;
  lines: string[];
  subtitle: string;
  layout: HeroLayout;
  date?: { datetime: string; long: string };
}
const { class: className, lines, subtitle, layout, date } = Astro.props;
const subtitleStyle = "font-serif text-xl leading-tight tracking-normal text-blush italic lg:text-2xl xl:text-3xl";
---

{/* Size containment keeps the title from widening its own column; the width keeps it from collapsing when centered. */}
<div class:list={["words @container w-full", className]}>
  {/* The lines are broken at build time to fit the real font; a wider fallback must not wrap them while it loads. */}
  <h1
    class:list={[
      "font-serif leading-none font-bold tracking-tight whitespace-nowrap md:tracking-tighter",
      heroTitleSize(lines, layout),
    ]}
  >
    {lines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </h1>
  <p class:list={["mt-3 md:mt-5", subtitleStyle]}>{subtitle}</p>
  {/* The date reads as the subtitle's second line, not a new block. */}
  {date && (
    <p class:list={["mt-0.5 md:mt-1", subtitleStyle]}>
      <time datetime={date.datetime}>{date.long}</time>
    </p>
  )}
  {/* Each hero picks its squiggle's color, so the words stay one component across the home and Halloween pages. */}
  <svg
    class="mx-auto mt-3.5 block h-3.5 w-28 fill-(--squiggle,var(--color-pink)) motion-safe:animate-paint md:mx-0 md:mt-5 md:h-4 md:w-32"
    viewBox="0 0 200 24"
    aria-hidden="true"
  >
    <path d={brushSquiggle(231, 200, 24, 3, 6)} />
  </svg>
</div>
