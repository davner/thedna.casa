---
import { brushSquiggle } from "../lib/shapes";
import { serif } from "../lib/serif";
interface Props {
  lines: string[];
  subtitle: string;
  fit?: number;
  date?: { datetime: string; long: string };
}
const { lines, subtitle, fit = 1, date } = Astro.props;
// The widest line in ems, so a long title shrinks to its column instead of pushing the stamp out of its slot.
const ems = Math.max(...lines.map((l) => serif.layout(l).advanceWidth / serif.unitsPerEm - 0.03 * [...l].length));
---

<div class="words">
  <h1 style={`--ems: ${ems.toFixed(3)}${fit < 1 ? `; --fit: ${fit}` : ""}`}>
    {lines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </h1>
  <p class="sub">{subtitle}</p>
  {date && (
    <p class="sub when">
      <time datetime={date.datetime}>{date.long}</time>
    </p>
  )}
  <svg class="squiggle" viewBox="0 0 200 24" aria-hidden="true">
    <path d={brushSquiggle(231, 200, 24, 3, 6)} />
  </svg>
</div>

<style>
  /* Size containment keeps the title from widening its own column; the width keeps it from collapsing when centered. */
  .words {
    container-type: inline-size;
    width: 100%;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: min(clamp(3.4rem, 10vw, 9.5rem), 100cqi / var(--ems));
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin: 0;
  }
  .sub {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    margin: 20px 0 0;
    color: var(--blush);
  }
  /* The date reads as the subtitle's second line, not a new block. */
  .sub.when {
    margin-top: 4px;
  }
  /* Each hero picks its squiggle's color, so the words stay one component across the home and Halloween pages. */
  .squiggle {
    display: block;
    width: 130px;
    height: 16px;
    margin: 18px 0 0;
    fill: var(--squiggle, var(--pink));
  }

  @media (prefers-reduced-motion: no-preference) {
    .squiggle {
      animation: paint 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
    }
  }
  @keyframes paint {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 760px) {
    h1 {
      font-size: calc(clamp(3rem, 14vw, 4.2rem) * var(--fit, 1));
      line-height: 0.88;
    }
    .sub {
      margin-top: 12px;
    }
    .sub.when {
      margin-top: 2px;
    }
    .squiggle {
      margin: 14px auto 0;
      width: 112px;
      height: 14px;
    }
  }
</style>
