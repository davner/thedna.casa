---
import { brushSquiggle } from "../lib/shapes";
import { heroTitleSize } from "../lib/hero-title";
interface Props {
  lines: string[];
  subtitle: string;
  layout: "beside" | "full";
  date?: { datetime: string; long: string };
}
const { lines, subtitle, layout, date } = Astro.props;
---

<div class="words">
  <h1 class={heroTitleSize(lines, layout)}>
    {lines.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </h1>
  <p class="sub">{subtitle}</p>
  {date && (
    <p class="sub when">
      <time datetime={date.datetime}>{date.long}</time>
    </p>
  )}
  <svg class="squiggle" viewBox="0 0 200 24" aria-hidden="true">
    <path d={brushSquiggle(231, 200, 24, 3, 6)} />
  </svg>
</div>

<style>
  /* Size containment keeps the title from widening its own column; the width keeps it from collapsing when centered. */
  .words {
    container-type: inline-size;
    width: 100%;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 700;
    /* The lines are broken at build time to fit the real font; a wider fallback must not wrap them while it loads. */
    white-space: nowrap;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    margin: 0;
  }
  .sub {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: var(--tracking-normal);
    font-size: var(--text-xl);
    margin: calc(var(--spacing) * 3) 0 0;
    color: var(--blush);
  }
  /* The date reads as the subtitle's second line, not a new block. */
  .sub.when {
    margin-top: calc(var(--spacing) * 0.5);
  }
  /* Each hero picks its squiggle's color, so the words stay one component across the home and Halloween pages. */
  .squiggle {
    display: block;
    width: calc(var(--spacing) * 28);
    height: calc(var(--spacing) * 3.5);
    margin: calc(var(--spacing) * 3.5) auto 0;
    fill: var(--squiggle, var(--pink));
  }

  @media (prefers-reduced-motion: no-preference) {
    .squiggle {
      animation: paint 1000ms var(--ease-out) 500ms backwards;
    }
  }
  @keyframes paint {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (width >= 48rem) {
    h1 {
      letter-spacing: var(--tracking-tighter);
    }
    .sub {
      margin-top: calc(var(--spacing) * 5);
    }
    .sub.when {
      margin-top: var(--spacing);
    }
    .squiggle {
      width: calc(var(--spacing) * 32);
      height: calc(var(--spacing) * 4);
      margin: calc(var(--spacing) * 5) 0 0;
    }
  }
  @media (width >= 64rem) {
    .sub {
      font-size: var(--text-2xl);
    }
  }
  @media (width >= 80rem) {
    .sub {
      font-size: var(--text-3xl);
    }
  }
</style>
