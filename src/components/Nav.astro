---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Casa" },
  { href: "/halloween/", label: "Halloween" },
];
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<nav class="nav" aria-label="Site">
  <ul class="inline">
    {links.map((l) => <li><a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>)}
  </ul>
</nav>

<style>
  .nav { position: absolute; z-index: 5; top: 0; left: 0; right: 0; height: 76px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-end; padding: 0 clamp(20px, 6vw, 96px); color: var(--cream); font-family: var(--font-serif); font-weight: 700; letter-spacing: -0.02em; }
  .inline { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; font-size: 1.3rem; }
  a { color: inherit; text-decoration: underline 2px transparent; text-underline-offset: 8px; }
  a:hover { text-decoration-color: currentColor; text-underline-offset: 5px; }
  a[aria-current="page"] { text-decoration-color: var(--terra); }
  a:focus-visible { outline: 2px solid var(--terra); outline-offset: 4px; border-radius: 2px; }
</style>
