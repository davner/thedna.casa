---
import { menuStrokes } from "../lib/shapes";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Casa", lang: "es" },
  { href: "/halloween/", label: "Halloween" },
];
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const strokes = menuStrokes(71);
const focusRing =
  "focus-visible:rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-terra";
// The underline sits on an inner span so its transition never animates the focus ring on the link.
const underline = (href: string) => [
  "underline decoration-2 underline-offset-8 group-hover:underline-offset-4 motion-safe:transition-all motion-safe:duration-200 motion-safe:ease-in-out",
  current(href) ? "decoration-terra" : "decoration-transparent group-hover:decoration-current",
];
---

<nav
  class="nav absolute inset-x-0 top-0 z-10 flex h-16 items-center justify-end px-5 font-serif font-bold tracking-tight text-cream md:h-20 md:px-12 lg:px-16 xl:px-20"
  aria-label="Site"
>
  <ul class="hidden gap-8 text-xl leading-tight md:flex">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          lang={l.lang}
          aria-current={current(l.href) ? "page" : undefined}
          class:list={["group", focusRing]}
        >
          <span class:list={underline(l.href)}>{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <button
    type="button"
    class:list={["grid size-12 -mr-2 cursor-pointer place-items-center md:hidden", focusRing]}
    popovertarget="site-menu"
    aria-label="Menu"
  >
    <svg class="w-9 fill-current overflow-visible" viewBox="0 0 40 40" aria-hidden="true">
      {strokes.map((d, i) => (
        <path class={`s${i}`} d={d} />
      ))}
    </svg>
  </button>
  {/* Right after its button, so focus and reading order move straight into the panel. */}
  <div
    id="site-menu"
    popover
    class="fixed inset-x-0 top-16 bottom-0 m-0 h-auto w-full max-w-none border-0 bg-(--dark) px-6 pt-4 pb-12 text-cream backdrop:bg-transparent md:hidden motion-safe:transition motion-safe:transition-discrete motion-safe:duration-200 motion-safe:ease-out motion-safe:not-open:-translate-y-2 motion-safe:not-open:opacity-0 motion-safe:starting:open:-translate-y-2 motion-safe:starting:open:opacity-0"
  >
    <ul class="grid gap-1">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            lang={l.lang}
            aria-current={current(l.href) ? "page" : undefined}
            class:list={["group block py-2.5 text-4xl leading-none tracking-tighter", focusRing]}
          >
            <span class:list={underline(l.href)}>{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  path {
    transform-box: view-box;
    transform-origin: center;
  }
  .nav:has(#site-menu:popover-open) .s0 {
    transform: rotate(45deg) translateY(calc(var(--spacing) * 2));
  }
  .nav:has(#site-menu:popover-open) .s1 {
    opacity: 0;
  }
  .nav:has(#site-menu:popover-open) .s2 {
    transform: rotate(-45deg) translateY(calc(var(--spacing) * -2));
  }
  @media (prefers-reduced-motion: no-preference) {
    path {
      transition:
        transform 200ms var(--ease-out),
        opacity 200ms var(--ease-out);
    }
  }
</style>
