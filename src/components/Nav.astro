---
import { menuStrokes } from "../lib/shapes";
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Casa", lang: "es" },
  { href: "/halloween/", label: "Halloween" },
];
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const strokes = menuStrokes(71);
---

<nav class="nav" aria-label="Site">
  <ul class="inline">
    {links.map((l) => (
      <li>
        <a href={l.href} lang={l.lang} aria-current={current(l.href) ? "page" : undefined}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  <button type="button" class="menu-btn" popovertarget="site-menu" aria-label="Menu">
    <svg viewBox="0 0 40 40" aria-hidden="true">
      {strokes.map((d, i) => (
        <path class={`s${i}`} d={d} />
      ))}
    </svg>
  </button>
  {/* Right after its button, so focus and reading order move straight into the panel. */}
  <div id="site-menu" popover>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} lang={l.lang} aria-current={current(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--spacing) * 16);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 calc(var(--spacing) * 5);
    color: var(--cream);
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }
  .inline {
    display: none;
    gap: calc(var(--spacing) * 8);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-xl);
  }
  a {
    color: inherit;
    text-decoration: underline 2px transparent;
    text-underline-offset: 8px;
  }
  a:hover {
    text-decoration-color: currentColor;
    text-underline-offset: 4px;
  }
  a[aria-current="page"] {
    text-decoration-color: var(--terra);
  }
  a:focus-visible,
  .menu-btn:focus-visible {
    outline: 2px solid var(--terra);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    margin-right: calc(var(--spacing) * -2);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .menu-btn svg {
    width: calc(var(--spacing) * 9);
    fill: currentColor;
    overflow: visible;
  }
  .menu-btn path {
    transform-box: view-box;
    transform-origin: 20px 20px;
  }
  .nav:has(#site-menu:popover-open) .s0 {
    transform: rotate(45deg) translateY(8px);
  }
  .nav:has(#site-menu:popover-open) .s1 {
    opacity: 0;
  }
  .nav:has(#site-menu:popover-open) .s2 {
    transform: rotate(-45deg) translateY(-8.25px);
  }
  #site-menu {
    position: fixed;
    inset: calc(var(--spacing) * 16) 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    border: 0;
    box-sizing: border-box;
    padding: calc(var(--spacing) * 4) calc(var(--spacing) * 6) calc(var(--spacing) * 12);
    background: var(--dark, var(--mole));
    color: var(--cream);
  }
  #site-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing);
  }
  #site-menu a {
    display: block;
    padding: calc(var(--spacing) * 2.5) 0;
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tighter);
    line-height: 1;
  }
  #site-menu::backdrop {
    background: transparent;
  }
  :global(body:has(#site-menu:popover-open)) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    a {
      transition:
        text-decoration-color 0.2s,
        text-underline-offset 0.2s;
    }
    .menu-btn path {
      transition:
        transform 0.2s ease-out,
        opacity 0.2s ease-out;
    }
    #site-menu {
      transition:
        opacity 0.2s ease-out,
        transform 0.2s ease-out,
        display 0.2s allow-discrete,
        overlay 0.2s allow-discrete;
    }
    #site-menu:not(:popover-open) {
      opacity: 0;
      transform: translateY(-8px);
    }
    @starting-style {
      #site-menu:popover-open {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
  }

  @media (width >= 48rem) {
    .nav {
      height: calc(var(--spacing) * 20);
      padding: 0 var(--gutter);
    }
    .inline {
      display: flex;
    }
    .menu-btn,
    #site-menu {
      display: none;
    }
  }
</style>
