---
import Stamp from "./Stamp.astro";
import HeroWords from "./HeroWords.astro";
import { copy } from "../content";
---

<header class="hero">
  <HeroWords lines={copy.wordmark} subtitle={copy.subtitle} layout="beside" />
  <Stamp />
</header>

<style>
  /* A short hero on phones, so the wave lands inside the first screen. */
  .hero {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gutter);
    padding: calc(var(--spacing) * 20) calc(var(--spacing) * 5) calc(var(--spacing) * 24);
    color: var(--cream);
    text-align: center;
  }
  /* At 45 degrees the turning ring's box is about 1.41x the stamp, which reaches past the screen edge up to tablet widths. */
  .hero {
    overflow-x: clip;
  }
  .hero :global(.stamp) {
    order: -1;
    flex: none;
    width: calc(var(--spacing) * 72);
    max-width: 100%;
  }

  /* A screen tall, with the next section pulled up over its foot so the wave and a strip of cream show on the first screen. */
  @media (width >= 48rem) {
    .hero {
      min-height: 100dvh;
      margin-bottom: calc(var(--spacing) * -20);
      flex-direction: row;
      padding: calc(var(--spacing) * 24) var(--gutter) calc(var(--spacing) * 36);
      text-align: start;
    }
    .hero :global(.stamp) {
      order: 0;
      width: 34%;
      max-width: calc(var(--spacing) * 96);
    }
    .hero :global(.words) {
      flex: 1;
      min-width: 0;
    }
  }
</style>
