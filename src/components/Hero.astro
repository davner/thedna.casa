---
import Stamp from "./Stamp.astro";
import HeroWords from "./HeroWords.astro";
import { copy } from "../content";
---

<header class="hero">
  <HeroWords lines={copy.wordmark} subtitle={copy.subtitle} />
  <Stamp />
</header>

<style>
  .hero {
    position: relative;
    box-sizing: border-box;
    min-height: min(92dvh, 880px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(380px, 34%);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding: 96px var(--gutter) 150px;
    color: var(--cream);
  }
  /* At 45 degrees the turning ring's box is about 1.41x the stamp, which reaches past the screen edge up to tablet widths. */
  .hero {
    overflow-x: clip;
  }
  .hero :global(.stamp) {
    width: 100%;
  }

  /* A short hero so the wave lands inside the first phone screen. */
  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 22px;
      padding: 72px 20px 92px;
      text-align: center;
    }
    .hero :global(.stamp) {
      order: -1;
      width: min(76vw, 300px);
    }
  }
</style>
