---
import { Image } from "astro:assets";
import { copy, members as householdMembers, type Member } from "../content";

interface Props {
  members?: Member[];
}
const { members = householdMembers } = Astro.props;
const circle = "block aspect-square h-auto w-20 flex-none rounded-full object-cover md:mb-3 md:w-full md:max-w-52";
---

<section
  class="bg-cream-page px-6 pt-2 pb-20 text-mole md:px-12 md:pt-0 md:pb-24 lg:px-16 lg:pb-28 xl:px-20 xl:pb-36"
  aria-labelledby="members-heading"
>
  <h2 id="members-heading" class="mx-auto max-w-6xl text-terra">
    {copy.membersHeading}
  </h2>
  {/* Columns keep their content height, so a short one-liner never stretches its circle or drops its name below the others. */}
  <ul class="mx-auto mt-7 grid max-w-6xl grid-cols-1 md:mt-12 md:grid-cols-4 md:gap-6 lg:gap-8 xl:gap-10">
    {members.map((m) => (
      <li class="flex items-center gap-5 border-t border-t-mole/14 py-3.5 last:border-b last:border-b-mole/14 md:flex-col md:items-center md:gap-1.5 md:border-none md:p-0 md:text-center">
        {m.portrait ? (
          <Image
            class={circle}
            src={m.portrait.src}
            alt={m.portrait.alt}
            width={416}
            height={416}
            widths={[208, 416]}
            sizes="(max-width: 767px) 80px, 208px"
          />
        ) : (
          <span class={circle} style={`background:${m.color}`}></span>
        )}
        <div class="grid gap-0.5 md:gap-1.5">
          <h3 class="font-serif text-2xl leading-tight font-bold tracking-tight md:text-3xl">{m.name}</h3>
          <span class="text-base leading-tight">{m.line}</span>
        </div>
      </li>
    ))}
  </ul>
</section>
