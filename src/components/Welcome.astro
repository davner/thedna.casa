---
import { Image } from "astro:assets";
import { copy, welcome as householdWelcome, type Welcome } from "../content";
import { softMask, wave } from "../lib/shapes";

interface Props {
  welcome?: Welcome;
}
const { welcome = householdWelcome } = Astro.props;
const outline = softMask(233, 4 / 5);
---

<section class="welcome" aria-labelledby="welcome-heading">
  <svg class="edge" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d={wave(232, 1440, 80, 2)} />
  </svg>
  <div class="inner">
    <div>
      <p class="kicker" lang="es">
        {copy.kicker}
      </p>
      <h2 id="welcome-heading">{copy.hello}</h2>
      <p class="text">{welcome.text}</p>
    </div>
    {welcome.photo ? (
      <>
        <svg class="defs" aria-hidden="true">
          <clipPath id="soft" clipPathUnits="objectBoundingBox">
            <path d={outline} />
          </clipPath>
        </svg>
        <Image
          class="photo"
          src={welcome.photo.src}
          alt={welcome.photo.alt}
          width={896}
          height={1120}
          widths={[288, 448, 576, 896]}
          sizes="(max-width: 767px) 288px, 448px"
        />
      </>
    ) : (
      <svg class="photo" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path d={outline} />
      </svg>
    )}
  </div>
</section>

<style>
  .welcome {
    position: relative;
    background: var(--cream-page);
    color: var(--mole);
    padding: calc(var(--spacing) * 6) var(--gutter) calc(var(--spacing) * 16);
  }
  .inner {
    display: grid;
    gap: calc(var(--spacing) * 7);
    align-items: center;
    max-width: var(--column);
    margin: 0 auto;
  }
  /* Sits on the section's top edge and dips one pixel into it, so no seam shows between wave and section. */
  .edge {
    position: absolute;
    left: 0;
    bottom: 100%;
    translate: 0 1px;
    width: 100%;
    /* A shallower wave on phones so the cream welcome starts inside the first screen. */
    height: calc(var(--spacing) * 12);
    display: block;
    fill: var(--cream-page);
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .photo {
    display: block;
    width: calc(var(--spacing) * 72);
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    justify-self: center;
    fill: var(--cheek);
    object-fit: cover;
  }
  img.photo {
    clip-path: url(#soft);
  }
  /* Bold large text, where terracotta on page cream (3.6:1) passes WCAG. */
  .kicker {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--terra);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 calc(var(--spacing) * 2);
  }
  h2 {
    text-wrap: balance;
  }
  .text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: var(--container-sm);
    margin: calc(var(--spacing) * 4) 0 0;
  }

  @media (width >= 48rem) {
    .welcome {
      padding-block: calc(var(--spacing) * 14) calc(var(--spacing) * 24);
    }
    .inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gutter);
    }
    .edge {
      height: calc(var(--spacing) * 20);
    }
    /* The words come first in the markup for phones; wider screens put the photo back on the left. */
    .photo {
      order: -1;
      width: 100%;
      max-width: var(--container-md);
    }
    .kicker {
      margin-bottom: calc(var(--spacing) * 2.5);
    }
    h2 {
      text-wrap: wrap;
    }
    .text {
      margin-top: calc(var(--spacing) * 6);
    }
  }
  @media (width >= 64rem) {
    .welcome {
      padding-top: calc(var(--spacing) * 16);
    }
  }
  @media (width >= 80rem) {
    .welcome {
      padding-block: calc(var(--spacing) * 24) calc(var(--spacing) * 32);
    }
    .text {
      font-size: var(--text-lg);
      max-width: var(--container-md);
    }
  }
</style>
