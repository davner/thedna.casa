---
import { Image } from "astro:assets";
import { copy, welcome as householdWelcome, type Welcome } from "../content";
import { softMask, wave } from "../lib/shapes";

interface Props {
  welcome?: Welcome;
}
const { welcome = householdWelcome } = Astro.props;
const outline = softMask(233, 4 / 5);
// The words come first in the markup for phones; wider screens put the photo back on the left.
const photo =
  "photo block aspect-4/5 h-auto w-72 max-w-full justify-self-center fill-cheek object-cover md:-order-1 md:w-full md:max-w-md";
---

<section
  class="welcome relative bg-cream-page gutter-x-6 pt-6 pb-16 text-mole md:pt-14 md:pb-24 lg:pt-16 xl:pt-24 xl:pb-32"
  aria-labelledby="welcome-heading"
>
  {/* Sits on the section's top edge and dips one pixel into it, so no seam shows between wave and section; shallower on
  phones so the cream welcome starts inside the first screen. */}
  <svg
    class="edge absolute bottom-full left-0 block h-12 w-full translate-y-px fill-cream-page md:h-20"
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d={wave(232, 1440, 80, 2)} />
  </svg>
  <div class="mx-auto grid max-w-6xl items-center gutter-gap-7 md:grid-cols-2">
    <div>
      {/* Bold large text, where terracotta on page cream (3.6:1) passes WCAG. */}
      <p class="mb-2 font-serif text-xl leading-tight font-bold tracking-tight text-terra md:mb-2.5" lang="es">
        {copy.kicker}
      </p>
      <h2 id="welcome-heading" class="text-balance md:text-wrap">
        {copy.hello}
      </h2>
      <p class="mt-4 max-w-sm text-base leading-relaxed md:mt-6 xl:max-w-md xl:text-lg">{welcome.text}</p>
    </div>
    {welcome.photo ? (
      <>
        <svg class="absolute h-0 w-0" aria-hidden="true">
          <clipPath id="soft" clipPathUnits="objectBoundingBox">
            <path d={outline} />
          </clipPath>
        </svg>
        <Image
          class={photo}
          src={welcome.photo.src}
          alt={welcome.photo.alt}
          width={896}
          height={1120}
          widths={[288, 448, 576, 896]}
          sizes="(max-width: 767px) 288px, 448px"
        />
      </>
    ) : (
      <svg class={photo} viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path d={outline} />
      </svg>
    )}
  </div>
</section>

<style>
  /* The soft mask is an SVG clip path, which no utility can point at. */
  img.photo {
    clip-path: url(#soft);
  }
</style>
