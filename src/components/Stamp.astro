---
import MarigoldMark from "./MarigoldMark.astro";
import { copy } from "../content";
interface Props {
  ring?: string;
}
const { ring = copy.ring } = Astro.props;
---

{/* The stamp only ever sits in the hero's slot: above the title on phones, beside the words from md. */}
<div class="stamp -order-1 w-72 max-w-full flex-none md:order-0 md:hero-slot">
  <svg class="ring-text" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id="stamp-ring" d="M100 100 m-82 0 a82 82 0 1 1 164 0 a82 82 0 1 1 -164 0" />
    </defs>
    <text>
      <textPath href="#stamp-ring" textLength="510" lengthAdjust="spacing">
        {ring}
      </textPath>
    </text>
  </svg>
  <slot>
    <MarigoldMark class="stamp-mark" />
  </slot>
</div>

<style>
  .stamp {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .ring-text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: currentColor;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-widest);
  }
  .stamp :global(.stamp-mark) {
    width: 64%;
    display: block;
    position: relative;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ring-text {
      animation: turn 40s linear infinite;
    }
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
</style>
