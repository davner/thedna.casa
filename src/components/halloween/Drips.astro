---
import { drips } from "../../lib/shapes";
import { palette } from "../../palette";
---

<svg class="drips" viewBox="0 0 2400 160" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
  <path d={drips(66, 2400, 160, 18)} fill={palette.trona} />
</svg>

<style>
  /* Placed first inside the cream block under a hero: the negative margin lets the content below start under the drips, and the 1px lift hides the seam with the hero. */
  .drips {
    position: relative;
    top: -1px;
    display: block;
    width: 100%;
    height: calc(var(--spacing) * 24);
    margin-bottom: calc(var(--spacing) * -24);
    pointer-events: none;
    overflow: visible;
  }
  /* Sliced at 1:1 so the round bulbs never squash; the shorter phone slice shows more of the edge at a smaller scale. */
  @media (width >= 48rem) {
    .drips {
      height: calc(var(--spacing) * 40);
      margin-bottom: calc(var(--spacing) * -40);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .drips {
      animation-name: drip-run;
      animation-duration: 500ms;
      animation-timing-function: var(--ease-out);
      animation-delay: 300ms;
      animation-fill-mode: backwards;
    }
  }
  @keyframes drip-run {
    from {
      clip-path: inset(0 0 88% 0);
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }
</style>
