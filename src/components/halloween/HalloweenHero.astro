---
interface Props { title: string[] }
const { title } = Astro.props;
---
<header class="hero">
  <div class="words">
    <h1>{title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
  </div>
</header>

<style>
  .hero { position: relative; box-sizing: border-box; min-height: min(92dvh, 880px); display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: clamp(32px, 6vw, 96px); padding: 96px clamp(20px, 6vw, 96px) 72px; color: var(--cream); overflow-x: clip; }
  h1 { font-family: var(--font-serif); font-weight: 700; font-size: clamp(3.4rem, 10vw, 9.5rem); letter-spacing: -0.03em; line-height: 0.9; margin: 0; }

  @media (max-width: 760px) {
    .hero { min-height: 0; grid-template-columns: 1fr; justify-items: center; gap: 22px; padding: 72px 20px 48px; text-align: center; }
    h1 { font-size: clamp(3rem, 15vw, 4.2rem); line-height: 0.88; }
  }
</style>
