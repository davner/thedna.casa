---
import Ghost from "./Ghost.astro";
import Stamp from "../Stamp.astro";
import HeroWords from "../HeroWords.astro";
interface Props {
  title: string[];
  subtitle: string;
  fit?: number;
  date?: { datetime: string; long: string };
  ring?: string;
}
const { title, subtitle, fit, date, ring } = Astro.props;
---

<header class:list={["hero", { short: !ring, keepsake: !ring && Astro.slots.has("keepsake") }]}>
  <HeroWords lines={title} subtitle={subtitle} fit={fit} date={date} />
  {/* A recap has no stamp, so its keepsake (the party's invite) takes the stamp's slot instead. */}
  {!ring && Astro.slots.has("keepsake") && (
    <div class="keepsake-slot">
      <slot name="keepsake" />
    </div>
  )}
  {ring && (
    <Stamp ring={ring}>
      <Ghost class="stamp-ghost" />
    </Stamp>
  )}
</header>

<style>
  .hero {
    position: relative;
    box-sizing: border-box;
    min-height: min(92dvh, 880px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(380px, 34%);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding: 96px var(--gutter) 150px;
    color: var(--cream);
    overflow-x: clip;
    --squiggle: var(--terra);
  }
  .hero.short {
    min-height: 0;
    grid-template-columns: 1fr;
    padding-top: clamp(120px, 14vw, 180px);
    padding-bottom: 56px;
  }
  .hero :global(.stamp) {
    width: 100%;
  }
  .hero.keepsake {
    grid-template-columns: minmax(0, 1fr) min(380px, 34%);
  }
  /* Above the drips, which hang from the main column into the hero's lower edge. */
  .keepsake-slot {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
  }
  .keepsake-slot :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(62vh, 540px);
  }
  .hero :global(.stamp-ghost) {
    width: 46%;
    display: block;
    position: relative;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 22px;
      padding: 72px 20px 48px;
      text-align: center;
    }
    .hero.short {
      padding-top: 104px;
      padding-bottom: 40px;
    }
    .hero :global(.stamp) {
      order: -1;
      width: min(76vw, 300px);
    }
    .hero.keepsake {
      grid-template-columns: 1fr;
    }
    /* Small enough that the drips still land on the first phone screen. */
    .keepsake-slot {
      order: -1;
    }
    .keepsake-slot :global(img) {
      max-height: 260px;
    }
  }
</style>
