---
import Ghost from "./Ghost.astro";
import Stamp from "../Stamp.astro";
import HeroWords from "../HeroWords.astro";
interface Props {
  title: string[];
  subtitle: string;
  date?: { datetime: string; long: string };
  ring?: string;
}
const { title, subtitle, date, ring } = Astro.props;
// A stamp or an invite beside the words narrows the title's column.
const beside = Boolean(ring) || Astro.slots.has("keepsake");
---

<header class:list={["hero", { short: !ring, keepsake: !ring && Astro.slots.has("keepsake") }]}>
  {/* A recap has no stamp, so its keepsake (the party's invite) takes the stamp's slot instead. It comes first in the
  markup because phones show it above the title; arriving after the title, it would push the title down mid-load. */}
  {!ring && Astro.slots.has("keepsake") && (
    <div class="keepsake-slot">
      <slot name="keepsake" />
    </div>
  )}
  <HeroWords lines={title} subtitle={subtitle} layout={beside ? "beside" : "full"} date={date} />
  {ring && (
    <Stamp ring={ring}>
      <Ghost class="stamp-ghost" />
    </Stamp>
  )}
</header>

<style>
  /* The same box as the home hero, so every title starts at one edge and the size model in hero-title.ts holds. */
  .hero {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gutter);
    padding: calc(var(--spacing) * 20) calc(var(--spacing) * 5) calc(var(--spacing) * 12);
    color: var(--cream);
    text-align: center;
    overflow-x: clip;
    --squiggle: var(--terra);
  }
  .hero.short {
    padding-top: calc(var(--spacing) * 24);
    padding-bottom: calc(var(--spacing) * 10);
  }
  .hero :global(.stamp) {
    order: -1;
    flex: none;
    width: calc(var(--spacing) * 72);
    max-width: 100%;
  }
  .hero :global(.stamp-ghost) {
    width: 46%;
    display: block;
    position: relative;
  }
  /* Above the drips, which hang from the main column into the hero's lower edge. */
  .keepsake-slot {
    position: relative;
    z-index: 2;
    align-self: stretch;
    display: grid;
    justify-items: center;
  }
  /* The card fits a square box on phones and the slot from md; its width comes from its own
  aspect ratio, so its box is reserved before the file arrives and nothing shifts. */
  .keepsake-slot :global(img) {
    display: block;
    width: calc(var(--spacing) * 64 * var(--aspect, 1));
    max-width: calc(var(--spacing) * 64);
    height: auto;
    aspect-ratio: var(--aspect, 1);
  }

  /* A screen tall, with the main pulled up over its foot so the drips start on the first desktop screen. */
  @media (width >= 48rem) {
    .hero {
      flex-direction: row;
      padding: calc(var(--spacing) * 24) var(--gutter) calc(var(--spacing) * 36);
      text-align: start;
    }
    .hero:not(.short) {
      min-height: 100dvh;
      margin-bottom: calc(var(--spacing) * -20);
    }
    .hero.short {
      padding-top: calc(var(--spacing) * 32);
      padding-bottom: calc(var(--spacing) * 14);
    }
    .hero :global(.stamp) {
      order: 0;
      width: 34%;
      max-width: calc(var(--spacing) * 96);
    }
    .hero :global(.words) {
      flex: 1;
      min-width: 0;
    }
    .keepsake-slot {
      order: 1;
      align-self: center;
      flex: none;
      width: 34%;
      max-width: calc(var(--spacing) * 96);
    }
    .keepsake-slot :global(img) {
      width: calc(var(--container-lg) * var(--aspect, 1));
      max-width: 100%;
    }
  }
  @media (width >= 64rem) {
    .hero.short {
      padding-top: calc(var(--spacing) * 36);
    }
  }
  @media (width >= 80rem) {
    .hero.short {
      padding-top: calc(var(--spacing) * 44);
    }
  }
</style>
