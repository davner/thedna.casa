---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import type { Share } from "../content";
interface Props {
  title: string;
  description: string;
  share?: Share;
}
const { title, description, share } = Astro.props;
---

<Base title={title} description={description} dark="trona" share={share}>
  <slot />
  <Footer />
</Base>
