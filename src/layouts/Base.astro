---
import "@fontsource/averia-serif-libre/400-italic.css";
import "@fontsource/averia-serif-libre/700.css";
import "@fontsource/schibsted-grotesk/400.css";
import "../styles/global.css";
import { palette } from "../palette";
import { copy, type Share } from "../content";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
  share?: Share;
}
const {
  title = copy.title,
  description = copy.description,
  themeColor = palette.mole,
  share = { path: "/share.png", alt: copy.shareImageAlt },
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(share.path, Astro.site).href;
const colorTokens = Object.entries(palette)
  .map(([name, hex]) => `--${name}:${hex}`)
  .join(";");
---

<!doctype html>
<html lang="en" style={colorTokens}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Nav />
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  :root {
    --font-serif: "Averia Serif Libre", serif;
    --divider: 1px solid color-mix(in srgb, var(--mole) 18%, transparent);
    --gutter: calc(var(--spacing) * 6);
    --column: var(--container-6xl);
  }
  @media (width >= 48rem) {
    :root {
      --gutter: calc(var(--spacing) * 12);
    }
  }
  @media (width >= 64rem) {
    :root {
      --gutter: calc(var(--spacing) * 16);
    }
  }
  @media (width >= 80rem) {
    :root {
      --gutter: calc(var(--spacing) * 20);
    }
  }
  html,
  body {
    margin: 0;
  }
  /* The fonts' own normal line height is about 1.23, and tight is the nearest Tailwind step. */
  html {
    line-height: var(--leading-tight);
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: var(--tracking-tighter);
    font-size: var(--text-4xl);
    line-height: 1;
    margin: 0;
  }
  @media (width >= 64rem) {
    h2 {
      font-size: var(--text-5xl);
    }
  }
  @media (width >= 80rem) {
    h2 {
      font-size: var(--text-6xl);
    }
  }
  body {
    background: var(--mole);
    color: var(--cream);
    font-family: "Schibsted Grotesk", sans-serif;
    letter-spacing: var(--tracking-tight);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }
  ::selection {
    background: var(--pink);
    color: var(--cream-page);
  }
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
    opacity: 0.22;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0 0.15 0 0 0 0.9 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
</style>
