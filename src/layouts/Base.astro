---
import "@fontsource/averia-serif-libre/400-italic.css";
import "@fontsource/averia-serif-libre/700.css";
import "@fontsource/schibsted-grotesk/400.css";
import "../styles/global.css";
import { palette } from "../palette";
import { copy, type Share } from "../content";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  // The page's dark field, which also fills the phone menu panel and tints the browser chrome.
  dark?: "mole" | "trona";
  share?: Share;
}
const {
  title = copy.title,
  description = copy.description,
  dark = "mole",
  share = { path: "/share.png", alt: copy.shareImageAlt },
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(share.path, Astro.site).href;
---

<!doctype html>
<html lang="en" class="leading-tight">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={copy.title} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={palette[dark]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body
    class="overflow-x-hidden bg-(--dark) font-sans tracking-tight text-cream antialiased menu-open:overflow-hidden"
    style={`--dark: var(--color-${dark})`}
  >
    <Nav />
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
