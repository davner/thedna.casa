---
import "@fontsource/averia-serif-libre/400.css";
import "@fontsource/averia-serif-libre/400-italic.css";
import "@fontsource/averia-serif-libre/700.css";
import "@fontsource/schibsted-grotesk/400.css";

interface Props { title?: string; description?: string }
const {
  title = "The DNA Casa",
  description = "Hola from Dan & Alexis, and Milly and Penny too. Come meet the household.",
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The DNA Casa" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#43262a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  :root {
    --mole: #43262a;
    --cream: #f6e7da;
    --cream-page: #faf4ec;
    --terra: #c8643c;
    --pink: #e4007c;
    --gold: #f2b233;
    --salamander: #2f3e3e;
    --sage: #b9c9b4;
    --cheek: #f7c6d9;
    --blush: #f0c7b4;
    --font-serif: "Averia Serif Libre", serif;
  }
  html, body { margin: 0; }
  h2 { font-family: var(--font-serif); font-weight: 700; letter-spacing: -0.04em; font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 1; margin: 0; }
  body {
    background: var(--mole);
    color: var(--cream);
    font-family: "Schibsted Grotesk", sans-serif;
    letter-spacing: -0.03em;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--pink); color: var(--cream-page); }
  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    opacity: 0.22;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0 0.15 0 0 0 0.9 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
</style>
