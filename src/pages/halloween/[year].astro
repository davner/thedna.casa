---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Halloween from "../../layouts/Halloween.astro";
import Drips from "../../components/halloween/Drips.astro";
import HalloweenHero from "../../components/halloween/HalloweenHero.astro";
import { heroTitleLines } from "../../lib/hero-title";
import { partyDate } from "../../lib/parties";
import { partyShare } from "../../lib/party-preview";
import { softMask } from "../../lib/shapes";

export async function getStaticPaths() {
  const parties = await getCollection("halloween");
  return parties.map((party) => ({ params: { year: String(party.data.year) }, props: { party } }));
}
const { party: entry } = Astro.props;
const party = entry.data;
const { Content } = await render(entry);
const title = heroTitleLines(party.name.toUpperCase());
type Photo = NonNullable<(typeof party.ourCostumes)[number]["photo"]>;
const photos = [...party.ourCostumes, ...party.highlights, party.contest, party.drinks].flatMap((item) =>
  item?.photo ? [item.photo] : [],
);
const softId = (photo: Photo) => `soft-${photo.seed}`;
const clip = (photo: Photo) => `clip-path:url(#${softId(photo)})`;
const sizes = { large: { shown: 500, phone: 300 }, small: { shown: 340, phone: 220 } } satisfies Record<
  Photo["size"],
  { shown: number; phone: number }
>;
// The contest, drinks and highlight photos all share one size beside their words.
// Every photo also ships at its phone width and twice that, so a phone never downloads the 2x desktop file.
const beside = { width: 840, height: 1050, widths: [280, 420, 560, 840], sizes: "(max-width: 760px) 280px, 420px" };
---

<Halloween
  title={`${party.name} · The DnA Casa`}
  share={partyShare(party)}
  description={`Our ${party.theme} Halloween, ${party.year}: costumes, the contest, the drinks and what was new.`}
>
  <HalloweenHero title={title} date={partyDate(party.date)} subtitle={`Our ${party.theme} Halloween`}>
    {party.invite && (
      <Image
        slot="keepsake"
        class="invite"
        style={`clip-path:url(#soft-invite); --aspect: ${party.invite.src.width / party.invite.src.height}`}
        src={party.invite.src}
        alt={party.invite.alt}
        width={760}
        widths={[260, 380, 520, 760]}
        sizes="(max-width: 760px) 260px, 380px"
        loading="eager"
      />
    )}
  </HalloweenHero>
  <main class="recap">
    <Drips />
    <svg class="defs" aria-hidden="true">
      {party.invite && (
        <clipPath id="soft-invite" clipPathUnits="objectBoundingBox">
          <path d={softMask(party.year, party.invite.src.width / party.invite.src.height)} />
        </clipPath>
      )}
      {photos.map((photo) => (
        <clipPath id={softId(photo)} clipPathUnits="objectBoundingBox">
          <path d={softMask(photo.seed, 4 / 5)} />
        </clipPath>
      ))}
    </svg>

    <section class="intro">
      <div class="intro-text reveal">
        <Content />
      </div>
    </section>

    {party.ourCostumes.length > 0 && (
      <section class="costumes" aria-labelledby="costumes-h">
        <h2 id="costumes-h" class="reveal">
          Our costumes
        </h2>
        <div class="costume-grid">
          {party.ourCostumes.map((c) => (
            <figure class:list={[c.photo?.size ?? "large", "reveal"]}>
              {c.photo && (
                <Image
                  class="photo"
                  style={clip(c.photo)}
                  src={c.photo.src}
                  alt={c.photo.alt}
                  width={2 * sizes[c.photo.size].shown}
                  height={2.5 * sizes[c.photo.size].shown}
                  widths={[
                    sizes[c.photo.size].phone,
                    sizes[c.photo.size].shown,
                    2 * sizes[c.photo.size].phone,
                    2 * sizes[c.photo.size].shown,
                  ]}
                  sizes={`(max-width: 760px) ${sizes[c.photo.size].phone}px, ${sizes[c.photo.size].shown}px`}
                />
              )}
              <figcaption>
                {c.who} as <span lang={c.asLang}>{c.as}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {party.contest && (
      <section class:list={["contest", { shot: party.contest.photo }]} aria-labelledby="contest-h">
        <div class="words reveal">
          <h2 id="contest-h">The costume contest</h2>
          {party.contest.rule && <p>{party.contest.rule}</p>}
          <p class="result">{party.contest.result}</p>
        </div>
        <ul class="winners reveal">
          {party.contest.winners.map((w) => (
            <li>
              <span class="names">{w.names}</span> <span class="as">as {w.costume}</span>
            </li>
          ))}
        </ul>
        {party.contest.photo && (
          <Image
            class="photo reveal"
            style={clip(party.contest.photo)}
            src={party.contest.photo.src}
            alt={party.contest.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.drinks && (
      <section class:list={["drinks reveal", { shot: party.drinks.photo }]} aria-labelledby="drinks-h">
        <div>
          <h2 id="drinks-h">The drinks</h2>
          <p class="drink-list">
            {party.drinks.names.map((d, i) => (
              <>
                {i > 0 && <span class="amp"> & </span>}
                <span class="drink">{d}</span>
              </>
            ))}
          </p>
          {party.drinks.by && <p class="by">Made by {party.drinks.by}.</p>}
        </div>
        {party.drinks.photo && (
          <Image
            class="photo"
            style={clip(party.drinks.photo)}
            src={party.drinks.photo.src}
            alt={party.drinks.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.highlights.length > 0 && (
      <section class="new" aria-labelledby="new-h">
        <h2 id="new-h" class="reveal">
          New this year
        </h2>
        <ul>
          {party.highlights.map((h, i) => (
            <li class:list={["reveal", { flip: i % 2 === 1, plain: !h.photo }]}>
              {h.photo && <Image class="photo" style={clip(h.photo)} src={h.photo.src} alt={h.photo.alt} {...beside} />}
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
              {h.frames && (
                <ol class="frames">
                  {h.frames.map((f) => (
                    <li>
                      <figure>
                        <Image
                          class="frame"
                          src={f.src}
                          alt={f.alt}
                          width={480}
                          widths={[160, 240, 320, 480]}
                          sizes="(max-width: 760px) 160px, 240px"
                        />
                        <figcaption>{f.caption}</figcaption>
                      </figure>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Halloween>

<style>
  .recap {
    background: var(--cream-page);
    color: var(--mole);
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  section {
    padding: 0 var(--inline) clamp(80px, 10vw, 140px);
  }
  h2 {
    color: var(--terra);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    margin: 0;
  }
  p {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    margin: 0;
  }
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 18px;
    font-size: 1rem;
    text-align: center;
  }

  .intro {
    padding-top: 190px;
    text-align: center;
  }
  .intro-text {
    max-width: 30ch;
    margin: 0 auto;
  }
  .intro-text :global(p) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.4;
    letter-spacing: 0;
    margin-block: 1em;
  }

  .costumes h2 {
    margin: 0 auto;
  }
  .costume-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
    margin: 48px auto 0;
  }
  .large .photo {
    max-width: 500px;
    margin: 0 auto;
  }
  /* The small photo sits lower than the large one beside it, so the pair reads as a step, not a row. */
  .small {
    margin-top: clamp(80px, 14vw, 200px);
  }
  .small .photo {
    max-width: 340px;
    margin: 0 auto;
  }

  .contest {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    margin: 0 auto;
    box-sizing: content-box;
  }
  .contest p {
    margin-top: 20px;
    max-width: 34ch;
  }
  .contest .result {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--terra);
  }
  /* With a photo, the words and winners stack on the left and the winners' photo stands beside them. */
  .contest.shot {
    grid-template-areas: "words photo" "winners photo";
    align-items: center;
  }
  .contest.shot .words {
    grid-area: words;
    align-self: end;
  }
  .contest.shot .winners {
    grid-area: winners;
    align-self: start;
  }
  .contest.shot .photo,
  .drinks.shot .photo {
    grid-area: photo;
    max-width: 420px;
    justify-self: center;
  }
  .winners {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .winners li {
    display: grid;
    gap: 4px;
    padding: 20px 0;
    border-top: var(--divider);
  }
  .winners li:last-child {
    border-bottom: var(--divider);
  }
  .names {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .as {
    font-size: 1rem;
  }

  .drinks > div {
    margin-inline: auto;
  }
  .drinks.shot {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    grid-template-areas: "words photo";
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    margin: 0 auto;
    box-sizing: content-box;
  }
  .drinks.shot > div {
    margin: 0;
  }
  .drink-list {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .drink {
    font-weight: 700;
  }
  .amp {
    font-style: italic;
    letter-spacing: 0;
  }
  .by {
    margin-top: 12px;
    font-size: 1rem;
  }

  .new h2 {
    margin: 0 auto;
  }
  .new ul {
    list-style: none;
    padding: 0;
    margin: 40px auto 0;
    display: grid;
    gap: clamp(48px, 7vw, 96px);
  }
  .new > ul > li {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .new > ul > li .photo {
    max-width: 420px;
    justify-self: center;
  }
  .new > ul > li.flip .photo {
    order: 1;
  }
  .new > ul > li p {
    margin-top: 12px;
    max-width: 34ch;
  }
  .new > ul > li.plain {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  /* Stills from one video, laid out like a contact strip and read left to right. */
  .frames {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 240px));
    justify-self: stretch;
    gap: clamp(16px, 2vw, 28px);
    justify-content: center;
  }
  .frame {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }
  .frames figcaption {
    margin-top: 12px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo {
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .photo:hover {
      transform: scale(1.02);
    }
  }

  @media (max-width: 760px) {
    section {
      padding: 0 var(--inline) 72px;
    }
    .intro {
      padding-top: 132px;
    }
    h2 {
      text-wrap: balance;
    }
    h3,
    .names,
    .drink-list {
      font-size: 1.5rem;
    }
    .costume-grid {
      grid-template-columns: 1fr;
      margin-top: 28px;
      gap: 40px;
    }
    .large .photo {
      max-width: 300px;
    }
    .small {
      margin-top: 0;
    }
    .small .photo {
      max-width: 220px;
    }
    .contest,
    .drinks.shot {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .contest.shot {
      grid-template-areas: "words" "photo" "winners";
    }
    .drinks.shot {
      grid-template-areas: "words" "photo";
    }
    .contest.shot .photo,
    .drinks.shot .photo {
      max-width: 280px;
    }
    .new > ul > li,
    .new > ul > li.flip {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .new > ul > li.flip .photo {
      order: 0;
    }
    .new > ul > li .photo {
      max-width: 280px;
    }
    .new > ul > li > div {
      text-align: center;
    }
    .new > ul > li p {
      margin-inline: auto;
    }
    .frames {
      grid-template-columns: repeat(2, minmax(0, 160px));
      gap: 16px;
    }
  }
</style>
