---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Halloween from "../../layouts/Halloween.astro";
import Drips from "../../components/halloween/Drips.astro";
import HalloweenHero from "../../components/halloween/HalloweenHero.astro";
import { heroTitleLines } from "../../lib/hero-title";
import { partyDate } from "../../lib/parties";
import { partyShare } from "../../lib/party-preview";
import { softMask } from "../../lib/shapes";

export async function getStaticPaths() {
  const parties = await getCollection("halloween");
  return parties.map((party) => ({ params: { year: String(party.data.year) }, props: { party } }));
}
const { party: entry } = Astro.props;
const party = entry.data;
const { Content } = await render(entry);
const title = heroTitleLines(party.name.toUpperCase());
type Photo = NonNullable<(typeof party.ourCostumes)[number]["photo"]>;
const photos = [...party.ourCostumes, ...party.highlights, party.contest, party.drinks].flatMap((item) =>
  item?.photo ? [item.photo] : [],
);
const inviteAspect = party.invite ? party.invite.src.width / party.invite.src.height : 1;
const softId = (photo: Photo) => `soft-${photo.seed}`;
const clip = (photo: Photo) => `clip-path:url(#${softId(photo)})`;
const sizes = { large: { shown: 512, phone: 288 }, small: { shown: 320, phone: 224 } } satisfies Record<
  Photo["size"],
  { shown: number; phone: number }
>;
// The contest, drinks and highlight photos all share one size beside their words.
// Every photo also ships at its phone width and twice that, so a phone never downloads the 2x desktop file.
const beside = { width: 896, height: 1120, widths: [288, 448, 576, 896], sizes: "(max-width: 767px) 288px, 448px" };
// Content-box, so the column caps the content inside the gutters while the cream runs edge to edge.
const section = "mx-auto box-content max-w-6xl px-6 pb-20 md:px-12 lg:px-16 lg:pb-24 xl:px-20 xl:pb-32";
const heading = "text-terra text-balance md:text-wrap";
const body = "text-base leading-relaxed xl:text-lg";
const photoClass =
  "block aspect-4/5 h-auto w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:hover:scale-105";
---

<Halloween
  title={`${party.name} · The DnA Casa`}
  share={partyShare(party)}
  description={`Our ${party.theme} Halloween, ${party.year}: costumes, the contest, the drinks and what was new.`}
>
  <HalloweenHero title={title} date={partyDate(party.date)} subtitle={`Our ${party.theme} Halloween`}>
    {party.invite && (
      <Image
        slot="keepsake"
        class="invite-width block aspect-(--aspect) h-auto max-w-64 md:max-w-full"
        style={`clip-path:url(#soft-invite); --aspect: ${inviteAspect}`}
        src={party.invite.src}
        alt={party.invite.alt}
        width={768}
        widths={[256, 384, 512, 768]}
        sizes="(max-width: 767px) 256px, 384px"
        loading="eager"
      />
    )}
  </HalloweenHero>
  <main class="bg-cream-page text-mole">
    <Drips />
    <svg class="absolute size-0" aria-hidden="true">
      {party.invite && (
        <clipPath id="soft-invite" clipPathUnits="objectBoundingBox">
          <path d={softMask(party.year, inviteAspect)} />
        </clipPath>
      )}
      {photos.map((photo) => (
        <clipPath id={softId(photo)} clipPathUnits="objectBoundingBox">
          <path d={softMask(photo.seed, 4 / 5)} />
        </clipPath>
      ))}
    </svg>

    <section class:list={[section, "pt-32 text-center md:pt-48"]}>
      <div class="reveal mx-auto max-w-2xs *:my-5 *:font-serif *:text-xl *:leading-snug *:tracking-normal *:italic lg:*:my-6 lg:*:text-2xl xl:*:my-8 xl:*:text-3xl">
        <Content />
      </div>
    </section>

    {party.ourCostumes.length > 0 && (
      <section class={section} aria-labelledby="costumes-h">
        <h2 id="costumes-h" class:list={["reveal mx-auto", heading]}>
          Our costumes
        </h2>
        <div class="mx-auto mt-7 grid grid-cols-1 items-start gap-10 md:mt-12 md:grid-cols-5 md:gap-12 lg:gap-16 xl:gap-20">
          {party.ourCostumes.map((c, i) => {
            const small = c.photo?.size === "small";
            return (
              <figure
                class:list={[
                  "reveal",
                  // Three fifths to two, so the large photo leads and the small one reads as its companion.
                  i % 2 === 0 ? "md:col-span-3" : "md:col-span-2",
                  // The small photo sits lower than the large one beside it, so the pair reads as a step, not a row.
                  { "md:mt-28 lg:mt-36 xl:mt-44": small },
                ]}
              >
                {c.photo && (
                  <Image
                    class:list={[photoClass, "mx-auto", small ? "max-w-56 md:max-w-80" : "max-w-72 md:max-w-lg"]}
                    style={clip(c.photo)}
                    src={c.photo.src}
                    alt={c.photo.alt}
                    width={2 * sizes[c.photo.size].shown}
                    height={2.5 * sizes[c.photo.size].shown}
                    widths={[
                      sizes[c.photo.size].phone,
                      sizes[c.photo.size].shown,
                      2 * sizes[c.photo.size].phone,
                      2 * sizes[c.photo.size].shown,
                    ]}
                    sizes={`(max-width: 767px) ${sizes[c.photo.size].phone}px, ${sizes[c.photo.size].shown}px`}
                  />
                )}
                <figcaption class="mt-5 text-center text-base leading-tight">
                  {c.who} as <span lang={c.asLang}>{c.as}</span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )}

    {party.contest && (
      <section
        class:list={[
          section,
          "grid grid-cols-1 gap-7 md:grid-cols-2 md:gap-12 lg:gap-16 xl:gap-20",
          party.contest.photo ? "items-center" : "items-end",
        ]}
        aria-labelledby="contest-h"
      >
        {/* With a photo, the words and winners stack on the left and the winners' photo stands beside them. */}
        <div class:list={["words reveal", { "self-end md:col-start-1 md:row-start-1": party.contest.photo }]}>
          <h2 id="contest-h" class={heading}>
            The costume contest
          </h2>
          {party.contest.rule && <p class:list={[body, "mt-5 max-w-xs xl:max-w-sm"]}>{party.contest.rule}</p>}
          <p class="mt-2 max-w-xs font-serif text-xl leading-relaxed font-bold tracking-tight text-terra xl:max-w-sm">
            {party.contest.result}
          </p>
        </div>
        <ul
          class:list={[
            "winners reveal",
            { "order-last self-start md:order-none md:col-start-1 md:row-start-2": party.contest.photo },
          ]}
        >
          {party.contest.winners.map((w) => (
            <li class="divider grid gap-1 py-5">
              <span class="font-serif text-2xl leading-tight font-bold tracking-tight md:text-3xl">{w.names}</span>{" "}
              <span class="text-base leading-tight">as {w.costume}</span>
            </li>
          ))}
        </ul>
        {party.contest.photo && (
          <Image
            class:list={[
              photoClass,
              "reveal max-w-72 justify-self-center md:col-start-2 md:row-start-1 md:row-end-3 md:max-w-md",
            ]}
            style={clip(party.contest.photo)}
            src={party.contest.photo.src}
            alt={party.contest.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.drinks && (
      <section
        class:list={[
          section,
          "reveal",
          { "grid grid-cols-1 items-center gap-7 md:grid-cols-2 md:gap-12 lg:gap-16 xl:gap-20": party.drinks.photo },
        ]}
        aria-labelledby="drinks-h"
      >
        <div class:list={{ "mx-auto": !party.drinks.photo }}>
          <h2 id="drinks-h" class={heading}>
            The drinks
          </h2>
          <p class="mt-7 font-serif text-2xl leading-tight tracking-tight text-balance md:text-3xl">
            {party.drinks.names.map((d, i) => (
              <>
                {i > 0 && <span class="tracking-normal italic"> & </span>}
                <span class="font-bold">{d}</span>
              </>
            ))}
          </p>
          {party.drinks.by && <p class="mt-3 text-base leading-relaxed">Made by {party.drinks.by}.</p>}
        </div>
        {party.drinks.photo && (
          <Image
            class:list={[photoClass, "max-w-72 justify-self-center md:max-w-md"]}
            style={clip(party.drinks.photo)}
            src={party.drinks.photo.src}
            alt={party.drinks.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.highlights.length > 0 && (
      <section class={section} aria-labelledby="new-h">
        <h2 id="new-h" class:list={["reveal mx-auto", heading]}>
          New this year
        </h2>
        <ul class="mx-auto mt-10 grid gap-12 md:gap-14 lg:gap-16 xl:gap-24">
          {party.highlights.map((h, i) => (
            <li
              class:list={[
                "reveal grid grid-cols-1 items-center gap-5 md:gap-12 lg:gap-16 xl:gap-20",
                h.photo ? "md:grid-cols-2" : "justify-items-center text-center",
              ]}
            >
              {h.photo && (
                <Image
                  class:list={[photoClass, "max-w-72 justify-self-center md:max-w-md", { "md:order-1": i % 2 === 1 }]}
                  style={clip(h.photo)}
                  src={h.photo.src}
                  alt={h.photo.alt}
                  {...beside}
                />
              )}
              <div class:list={["text-center", { "md:text-start": h.photo }]}>
                <h3>{h.title}</h3>
                <p class:list={[body, "mx-auto mt-3 max-w-xs xl:max-w-sm", { "md:mx-0": h.photo }]}>{h.text}</p>
              </div>
              {h.frames && (
                <ol class="frame-strip mt-6 grid justify-center justify-self-stretch gap-4 lg:gap-5 xl:gap-6">
                  {h.frames.map((f) => (
                    <li>
                      <figure>
                        <Image
                          class="block h-auto w-full rounded-2xl"
                          src={f.src}
                          alt={f.alt}
                          width={480}
                          widths={[160, 240, 320, 480]}
                          sizes="(max-width: 767px) 160px, 240px"
                        />
                        <figcaption class="mt-3 text-center text-base leading-tight">{f.caption}</figcaption>
                      </figure>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Halloween>
