---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Halloween from "../../layouts/Halloween.astro";
import Drips from "../../components/halloween/Drips.astro";
import HalloweenHero from "../../components/halloween/HalloweenHero.astro";
import { heroTitleLines } from "../../lib/hero-title";
import { partyDate } from "../../lib/parties";
import { partyShare } from "../../lib/party-preview";
import { softMask } from "../../lib/shapes";

export async function getStaticPaths() {
  const parties = await getCollection("halloween");
  return parties.map((party) => ({ params: { year: String(party.data.year) }, props: { party } }));
}
const { party: entry } = Astro.props;
const party = entry.data;
const { Content } = await render(entry);
const title = heroTitleLines(party.name.toUpperCase());
type Photo = NonNullable<(typeof party.ourCostumes)[number]["photo"]>;
const photos = [...party.ourCostumes, ...party.highlights, party.contest, party.drinks].flatMap((item) =>
  item?.photo ? [item.photo] : [],
);
const inviteAspect = party.invite ? party.invite.src.width / party.invite.src.height : 1;
const softId = (photo: Photo) => `soft-${photo.seed}`;
const clip = (photo: Photo) => `clip-path:url(#${softId(photo)})`;
const sizes = { large: { shown: 512, phone: 288 }, small: { shown: 320, phone: 224 } } satisfies Record<
  Photo["size"],
  { shown: number; phone: number }
>;
// The contest, drinks and highlight photos all share one size beside their words.
// Every photo also ships at its phone width and twice that, so a phone never downloads the 2x desktop file.
const beside = { width: 896, height: 1120, widths: [288, 448, 576, 896], sizes: "(max-width: 767px) 288px, 448px" };
---

<Halloween
  title={`${party.name} · The DnA Casa`}
  share={partyShare(party)}
  description={`Our ${party.theme} Halloween, ${party.year}: costumes, the contest, the drinks and what was new.`}
>
  <HalloweenHero title={title} date={partyDate(party.date)} subtitle={`Our ${party.theme} Halloween`}>
    {party.invite && (
      <Image
        slot="keepsake"
        class="invite-width block aspect-(--aspect) h-auto max-w-64 md:max-w-full"
        style={`clip-path:url(#soft-invite); --aspect: ${inviteAspect}`}
        src={party.invite.src}
        alt={party.invite.alt}
        width={768}
        widths={[256, 384, 512, 768]}
        sizes="(max-width: 767px) 256px, 384px"
        loading="eager"
      />
    )}
  </HalloweenHero>
  <main class="recap">
    <Drips />
    <svg class="defs" aria-hidden="true">
      {party.invite && (
        <clipPath id="soft-invite" clipPathUnits="objectBoundingBox">
          <path d={softMask(party.year, inviteAspect)} />
        </clipPath>
      )}
      {photos.map((photo) => (
        <clipPath id={softId(photo)} clipPathUnits="objectBoundingBox">
          <path d={softMask(photo.seed, 4 / 5)} />
        </clipPath>
      ))}
    </svg>

    <section class="intro">
      <div class="intro-text reveal">
        <Content />
      </div>
    </section>

    {party.ourCostumes.length > 0 && (
      <section class="costumes" aria-labelledby="costumes-h">
        <h2 id="costumes-h" class="reveal">
          Our costumes
        </h2>
        <div class="costume-grid">
          {party.ourCostumes.map((c) => (
            <figure class:list={[c.photo?.size ?? "large", "reveal"]}>
              {c.photo && (
                <Image
                  class="photo"
                  style={clip(c.photo)}
                  src={c.photo.src}
                  alt={c.photo.alt}
                  width={2 * sizes[c.photo.size].shown}
                  height={2.5 * sizes[c.photo.size].shown}
                  widths={[
                    sizes[c.photo.size].phone,
                    sizes[c.photo.size].shown,
                    2 * sizes[c.photo.size].phone,
                    2 * sizes[c.photo.size].shown,
                  ]}
                  sizes={`(max-width: 767px) ${sizes[c.photo.size].phone}px, ${sizes[c.photo.size].shown}px`}
                />
              )}
              <figcaption>
                {c.who} as <span lang={c.asLang}>{c.as}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {party.contest && (
      <section class:list={["contest", { shot: party.contest.photo }]} aria-labelledby="contest-h">
        <div class="words reveal">
          <h2 id="contest-h">The costume contest</h2>
          {party.contest.rule && <p>{party.contest.rule}</p>}
          <p class="result">{party.contest.result}</p>
        </div>
        <ul class="winners reveal">
          {party.contest.winners.map((w) => (
            <li>
              <span class="names">{w.names}</span> <span class="as">as {w.costume}</span>
            </li>
          ))}
        </ul>
        {party.contest.photo && (
          <Image
            class="photo reveal"
            style={clip(party.contest.photo)}
            src={party.contest.photo.src}
            alt={party.contest.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.drinks && (
      <section class:list={["drinks reveal", { shot: party.drinks.photo }]} aria-labelledby="drinks-h">
        <div>
          <h2 id="drinks-h">The drinks</h2>
          <p class="drink-list">
            {party.drinks.names.map((d, i) => (
              <>
                {i > 0 && <span class="amp"> & </span>}
                <span class="drink">{d}</span>
              </>
            ))}
          </p>
          {party.drinks.by && <p class="by">Made by {party.drinks.by}.</p>}
        </div>
        {party.drinks.photo && (
          <Image
            class="photo"
            style={clip(party.drinks.photo)}
            src={party.drinks.photo.src}
            alt={party.drinks.photo.alt}
            {...beside}
          />
        )}
      </section>
    )}

    {party.highlights.length > 0 && (
      <section class="new" aria-labelledby="new-h">
        <h2 id="new-h" class="reveal">
          New this year
        </h2>
        <ul>
          {party.highlights.map((h, i) => (
            <li class:list={["reveal", { flip: i % 2 === 1, plain: !h.photo }]}>
              {h.photo && <Image class="photo" style={clip(h.photo)} src={h.photo.src} alt={h.photo.alt} {...beside} />}
              <div>
                <h3>{h.title}</h3>
                <p>{h.text}</p>
              </div>
              {h.frames && (
                <ol class="frames">
                  {h.frames.map((f) => (
                    <li>
                      <figure>
                        <Image
                          class="frame"
                          src={f.src}
                          alt={f.alt}
                          width={480}
                          widths={[160, 240, 320, 480]}
                          sizes="(max-width: 767px) 160px, 240px"
                        />
                        <figcaption>{f.caption}</figcaption>
                      </figure>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Halloween>

<style>
  .recap {
    background: var(--cream-page);
    color: var(--mole);
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  /* Content-box, so the column caps the content inside the gutters while the cream runs edge to edge. */
  section {
    box-sizing: content-box;
    max-width: var(--column);
    margin-inline: auto;
    padding: 0 var(--gutter) calc(var(--spacing) * 20);
  }
  h2 {
    color: var(--terra);
    text-wrap: balance;
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: calc(var(--spacing) * 5);
    font-size: var(--text-base);
    text-align: center;
  }

  .intro {
    padding-top: calc(var(--spacing) * 32);
    text-align: center;
  }
  .intro-text {
    max-width: var(--container-2xs);
    margin: 0 auto;
  }
  .intro-text :global(p) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-normal);
    margin-block: calc(var(--spacing) * 5);
  }

  .costumes h2 {
    margin: 0 auto;
  }
  .costume-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: calc(var(--spacing) * 10);
    align-items: start;
    margin: calc(var(--spacing) * 7) auto 0;
  }
  .large .photo {
    max-width: calc(var(--spacing) * 72);
    margin: 0 auto;
  }
  .small .photo {
    max-width: calc(var(--spacing) * 56);
    margin: 0 auto;
  }

  .contest {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: calc(var(--spacing) * 7);
    align-items: end;
  }
  .contest p {
    margin-top: calc(var(--spacing) * 5);
    max-width: var(--container-xs);
  }
  .contest .result {
    margin-top: calc(var(--spacing) * 2);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
    color: var(--terra);
  }
  /* With a photo, the words and winners stack on the left and the winners' photo stands beside them. */
  .contest.shot {
    grid-template-areas: "words" "photo" "winners";
    align-items: center;
  }
  .contest.shot .words {
    grid-area: words;
    align-self: end;
  }
  .contest.shot .winners {
    grid-area: winners;
    align-self: start;
  }
  .contest.shot .photo,
  .drinks.shot .photo {
    grid-area: photo;
    max-width: calc(var(--spacing) * 72);
    justify-self: center;
  }
  .winners {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .winners li {
    display: grid;
    gap: var(--spacing);
    padding: calc(var(--spacing) * 5) 0;
    border-top: var(--divider);
  }
  .winners li:last-child {
    border-bottom: var(--divider);
  }
  .names {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }
  .as {
    font-size: var(--text-base);
  }

  .drinks > div {
    margin-inline: auto;
  }
  .drinks.shot {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-template-areas: "words" "photo";
    gap: calc(var(--spacing) * 7);
    align-items: center;
  }
  .drinks.shot > div {
    margin: 0;
  }
  .drink-list {
    margin-top: calc(var(--spacing) * 7);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  .drink {
    font-weight: 700;
  }
  .amp {
    font-style: italic;
    letter-spacing: var(--tracking-normal);
  }
  .by {
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--text-base);
  }

  .new h2 {
    margin: 0 auto;
  }
  .new ul {
    list-style: none;
    padding: 0;
    margin: calc(var(--spacing) * 10) auto 0;
    display: grid;
    gap: calc(var(--spacing) * 12);
  }
  .new > ul > li {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: calc(var(--spacing) * 5);
    align-items: center;
  }
  .new > ul > li .photo {
    max-width: calc(var(--spacing) * 72);
    justify-self: center;
  }
  .new > ul > li > div {
    text-align: center;
  }
  .new > ul > li p {
    margin-top: calc(var(--spacing) * 3);
    margin-inline: auto;
    max-width: var(--container-xs);
  }
  .new > ul > li.plain {
    text-align: center;
    justify-items: center;
  }

  /* Stills from one video, laid out like a contact strip and read left to right. */
  .frames {
    list-style: none;
    padding: 0;
    margin: calc(var(--spacing) * 6) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, calc(var(--spacing) * 40)));
    justify-self: stretch;
    gap: calc(var(--spacing) * 4);
    justify-content: center;
  }
  .frame {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-2xl);
  }
  .frames figcaption {
    margin-top: calc(var(--spacing) * 3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo {
      transition: transform 500ms var(--ease-out);
    }
    .photo:hover {
      transform: scale(1.05);
    }
  }

  @media (width >= 48rem) {
    h2 {
      text-wrap: wrap;
    }
    h3,
    .names,
    .drink-list {
      font-size: var(--text-3xl);
    }
    .intro {
      padding-top: calc(var(--spacing) * 48);
    }
    /* Three fifths to two, so the large photo leads and the small one reads as its companion. */
    .costume-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--gutter);
      margin-top: calc(var(--spacing) * 12);
    }
    .costume-grid > :nth-child(odd) {
      grid-column: span 3 / span 3;
    }
    .costume-grid > :nth-child(even) {
      grid-column: span 2 / span 2;
    }
    .large .photo {
      max-width: var(--container-lg);
    }
    /* The small photo sits lower than the large one beside it, so the pair reads as a step, not a row. */
    .small {
      margin-top: calc(var(--spacing) * 28);
    }
    .small .photo {
      max-width: calc(var(--spacing) * 80);
    }
    .contest,
    .drinks.shot,
    .new > ul > li {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gutter);
    }
    .contest.shot {
      grid-template-areas: "words photo" "winners photo";
    }
    .drinks.shot {
      grid-template-areas: "words photo";
    }
    .contest.shot .photo,
    .drinks.shot .photo,
    .new > ul > li .photo {
      max-width: var(--container-md);
    }
    .new ul {
      gap: calc(var(--spacing) * 14);
    }
    .new > ul > li > div {
      text-align: start;
    }
    .new > ul > li p {
      margin-inline: 0;
    }
    .new > ul > li.flip .photo {
      order: 1;
    }
    .new > ul > li.plain {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
    .new > ul > li.plain > div {
      text-align: center;
    }
    .new > ul > li.plain p {
      margin-inline: auto;
    }
    .frames {
      grid-template-columns: repeat(4, minmax(0, calc(var(--spacing) * 60)));
    }
  }
  @media (width >= 64rem) {
    section {
      padding-bottom: calc(var(--spacing) * 24);
    }
    .intro-text :global(p) {
      font-size: var(--text-2xl);
      margin-block: calc(var(--spacing) * 6);
    }
    .small {
      margin-top: calc(var(--spacing) * 36);
    }
    .new ul {
      gap: calc(var(--spacing) * 16);
    }
    .frames {
      gap: calc(var(--spacing) * 5);
    }
  }
  @media (width >= 80rem) {
    section {
      padding-bottom: calc(var(--spacing) * 32);
    }
    p {
      font-size: var(--text-lg);
    }
    .intro-text :global(p) {
      font-size: var(--text-3xl);
      margin-block: calc(var(--spacing) * 8);
    }
    .contest p,
    .new > ul > li p {
      max-width: var(--container-sm);
    }
    .small {
      margin-top: calc(var(--spacing) * 44);
    }
    .new ul {
      gap: calc(var(--spacing) * 24);
    }
    .frames {
      gap: calc(var(--spacing) * 6);
    }
  }
</style>
