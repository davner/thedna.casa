---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Halloween from "../../layouts/Halloween.astro";
import Drips from "../../components/halloween/Drips.astro";
import HalloweenHero from "../../components/halloween/HalloweenHero.astro";
import Trophy from "../../components/halloween/Trophy.astro";
import { newestFirst, partyDate } from "../../lib/parties";

const parties = newestFirst(await getCollection("halloween"));
---

<Halloween title="Halloween · The DnA Casa" description="Every Halloween party at the casa, newest first.">
  <HalloweenHero title={["HALLOWEEN"]} subtitle="October at the casa" ring="HALLOWEEN · THE DnA CASA · CON CARIÑO · " />
  <main class="bg-cream-page text-mole">
    <Drips />
    <Trophy parties={parties} />
    {/* Content-box, so the column caps the content inside the gutters while the cream runs edge to edge. */}
    <section class="mx-auto box-content max-w-6xl gutter-x-6 pb-20 lg:pb-28 xl:pb-36">
      <h2 class="reveal text-terra">The parties</h2>
      <ul class="mt-9">
        {parties.map(({ data: party }) => {
          // A party with no photos yet still gets a thumbnail, cut from its invite.
          const photo = party.ourCostumes.find((c) => c.photo)?.photo ?? party.invite;
          const day = partyDate(party.date);
          return (
            <li class="reveal divider">
              <a
                class="group flex items-center gap-4 py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-terra md:gap-8 lg:gap-10 xl:gap-12"
                href={`/halloween/${party.year}/`}
              >
                <span class="font-serif text-2xl leading-none font-bold tracking-tight text-terra lining-nums md:text-3xl">
                  {party.year}
                </span>{" "}
                <span class="grid min-w-0 flex-1 grid-cols-1 gap-1">
                  <span class="font-serif text-2xl leading-tight font-bold tracking-tight wrap-break-word underline decoration-transparent decoration-2 underline-offset-8 group-hover:decoration-current group-hover:underline-offset-4 group-focus-visible:decoration-current group-focus-visible:underline-offset-4 md:text-3xl motion-safe:transition-all motion-safe:duration-200 motion-safe:ease-in-out">
                    {party.name}
                  </span>{" "}
                  <span class="text-base leading-tight">A {party.theme} Halloween</span>{" "}
                  <time class="text-base leading-tight" datetime={day.datetime}>
                    {day.short}
                  </time>
                </span>
                {photo && (
                  <Image
                    class="aspect-square h-auto w-20 shrink-0 object-cover lg:w-24 xl:w-28 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-out motion-safe:group-hover:scale-105"
                    style="clip-path: circle(50%)"
                    src={photo.src}
                    alt=""
                    width={224}
                    height={224}
                    widths={[112, 224]}
                    sizes="(min-width: 80rem) 112px, (min-width: 64rem) 96px, 80px"
                  />
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
</Halloween>
